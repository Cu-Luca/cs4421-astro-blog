---
import BackToTop from '../../components/BackToTop.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Field notes | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(100% - 3rem, 1200px);
				max-width: 1200px;
				min-height: 62vh;
				padding: clamp(4rem, 10vw, 8rem) 0;
			}

			.eyebrow {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				color: var(--accent);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				text-transform: uppercase;
			}

			.eyebrow::before {
				width: 2rem;
				height: 1px;
				background: currentColor;
				content: '';
			}

			h1 {
				max-width: 12ch;
				margin: 1.5rem 0;
				font-size: clamp(3rem, 7vw, 6rem);
				font-weight: 500;
				letter-spacing: -0.055em;
				line-height: 1;
			}

			.intro {
				max-width: 38rem;
				color: var(--muted);
				font-size: 1.1rem;
			}

			.note-card {
				max-width: 46rem;
				margin-top: 3rem;
				padding: 2rem;
				border: 1px solid var(--line);
				background: var(--paper-light);
			}

			.note-card h2 {
				margin: 0 0 0.7rem;
				font-size: 1.6rem;
				font-weight: 500;
			}

			.note-card p {
				margin: 0;
				color: var(--muted);
			}

			.home-link {
				display: inline-block;
				margin-top: 1.5rem;
				font-size: 0.9rem;
				font-weight: 700;
				text-underline-offset: 0.25em;
			}

			@media (max-width: 600px) {
				main {
					width: calc(100% - 2rem);
				}

				.note-card {
					padding: 1.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">From the Atlantic edge</p>
			<h1>Field notes</h1>
			<p class="intro">
				Observations, seasonal sightings and stories from Ireland’s western shore will find a home
				here.
			</p>
			<section class="note-card" aria-labelledby="notes-status">
				<h2 id="notes-status">The notebook is still open.</h2>
				<p>
					No field notes have been published yet. The first stories will appear here when they’re
					ready.
				</p>
				<a class="home-link" href="/">Return to the field guide</a>
			</section>
		</main>
		<Footer />
		<BackToTop />
	</body>
</html>
