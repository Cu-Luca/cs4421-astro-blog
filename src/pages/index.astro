---
import { Image } from 'astro:assets';
import BackToTop from '../components/BackToTop.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import puffinImage from '../assets/birds/puffin-skellig.jpg';
import fulmarImage from '../assets/birds/fulmars-clashmealcon.jpg';
import curlewImage from '../assets/birds/curlew-dingle.jpg';
import shorebirdsImage from '../assets/birds/cormorant-heron-tralee.jpg';

const birds = [
	{
		name: 'The Atlantic puffin',
		scientificName: 'Fratercula arctica',
		place: 'Skellig Michael, County Kerry',
		image: puffinImage,
		alt: 'An Atlantic puffin standing among greenery on Skellig Michael',
		description: 'A summer visitor to offshore islands, instantly recognisable by its bright bill.',
		photo: 'Sascha Wenninger',
		source: 'https://commons.wikimedia.org/wiki/File:Puffin_Skellig_Michael_2015.jpg',
		license: 'https://creativecommons.org/licenses/by-sa/2.0/',
		licenseName: 'CC BY-SA 2.0',
	},
	{
		name: 'The northern fulmar',
		scientificName: 'Fulmarus glacialis',
		place: 'Clashmealcon cliffs, County Kerry',
		image: fulmarImage,
		alt: 'Fulmars nesting on a ledge of the Clashmealcon cliffs in County Kerry',
		description: 'A master of the wind, gliding low over the Atlantic and nesting on sea cliffs.',
		photo: 'Dm4244',
		source:
			'https://commons.wikimedia.org/wiki/File:DM2026_Fulmars_nexting_on_Clashmealcon_cliffs.jpg',
		license: 'https://creativecommons.org/licenses/by-sa/4.0/',
		licenseName: 'CC BY-SA 4.0',
	},
	{
		name: 'The Eurasian curlew',
		scientificName: 'Numenius arquata',
		place: 'Dingle Peninsula, County Kerry',
		image: curlewImage,
		alt: 'A Eurasian curlew feeding at Caher Marsh on the Dingle Peninsula',
		description: 'Its rippling call carries across the coastal marshes and tidal flats.',
		photo: 'Maoileann',
		source:
			'https://commons.wikimedia.org/wiki/File:Curlew-1013817,_Dingle_Peninsula,_Co._Kerry,_Ireland.jpg',
		license: 'https://creativecommons.org/licenses/by-sa/4.0/',
		licenseName: 'CC BY-SA 4.0',
	},
	{
		name: 'Estuary neighbours',
		scientificName: 'Cormorant & grey heron',
		place: 'Aughacasla Strand, County Kerry',
		image: shorebirdsImage,
		alt: 'A cormorant and a grey heron at the shore of Tralee Bay',
		description: 'Look for patient herons and dark, low-sitting cormorants around sheltered bays.',
		photo: 'Maoileann',
		source:
			'https://commons.wikimedia.org/wiki/File:Cormorant_%26_Heron-3091,_Tralee_Bay,_Co._Kerry,_Ireland.jpg',
		license: 'https://creativecommons.org/licenses/by-sa/4.0/',
		licenseName: 'CC BY-SA 4.0',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={puffinImage} />
		<meta name="theme-color" content="#f6f4ee" />
		<style>
			.home-main {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
			}

			.wrap {
				width: min(100% - 3rem, 1200px);
				margin-inline: auto;
			}

			.hero {
				display: grid;
				width: min(100% - 3rem, 1200px);
				min-height: 650px;
				grid-template-columns: 0.85fr 1.15fr;
				align-items: center;
				gap: clamp(2rem, 6vw, 6rem);
				margin: auto;
				padding: 4.5rem 0 5rem;
			}

			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				margin: 0 0 1.5rem;
				color: var(--accent);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				text-transform: uppercase;
			}

			.eyebrow::before {
				width: 2rem;
				height: 1px;
				background: currentColor;
				content: '';
			}

			.hero h1 {
				max-width: 12ch;
				margin: 0;
				font-size: clamp(3.3rem, 6.5vw, 6.4rem);
				font-weight: 500;
				letter-spacing: -0.055em;
				line-height: 0.99;
			}

			.hero-copy > p:not(.eyebrow) {
				max-width: 34rem;
				margin: 1.5rem 0 0;
				color: var(--muted);
				font-size: 1.06rem;
				line-height: 1.8;
			}

			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 1.2rem;
				margin-top: 2rem;
			}

			.primary-link {
				display: inline-flex;
				min-height: 3rem;
				align-items: center;
				justify-content: center;
				padding: 0.7rem 1.2rem;
				border-radius: 2px;
				background: var(--accent);
				color: white;
				font-size: 0.88rem;
				font-weight: 700;
				text-decoration: none;
				transition: background 160ms ease, transform 160ms ease;
			}

			.primary-link:hover {
				transform: translateY(-2px);
				background: var(--accent-dark);
				color: white;
			}

			.text-link {
				color: var(--ink);
				font-size: 0.88rem;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.25em;
			}

			.hero-figure {
				position: relative;
				margin: 0;
				padding: 0 0 2rem 2rem;
			}

			.hero-figure::before {
				position: absolute;
				top: 2rem;
				right: 0;
				bottom: 0;
				left: 0;
				border: 1px solid #cad3c6;
				content: '';
			}

			.hero-photo {
				position: relative;
				display: block;
				width: 100%;
				height: min(62vw, 540px);
				min-height: 360px;
				object-fit: cover;
				object-position: 54% center;
				box-shadow: var(--box-shadow);
			}

			.hero-caption {
				position: absolute;
				right: 1rem;
				bottom: 3rem;
				left: 3rem;
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 1rem;
				padding: 2.4rem 1rem 0.6rem;
				background: linear-gradient(transparent, rgba(12, 27, 24, 0.76));
				color: white;
				font-size: 0.76rem;
			}

			.hero-caption span {
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 1rem;
			}

			.photo-credit {
				color: inherit;
				font-size: 0.68rem;
				text-align: right;
			}

			.photo-credit a {
				color: inherit;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.18em;
			}

			.section {
				padding: 6.5rem 0;
			}

			.section-heading {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 2rem;
				margin-bottom: 2.5rem;
			}

			.section-heading h2 {
				max-width: 13ch;
				margin: 0;
				font-size: clamp(2.4rem, 4.5vw, 4rem);
				font-weight: 500;
				letter-spacing: -0.04em;
			}

			.section-heading > p {
				max-width: 25rem;
				margin: 0 0 0.3rem;
				color: var(--muted);
				font-size: 0.95rem;
			}

			.bird-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.5rem;
			}

			.bird-card {
				min-width: 0;
				background: var(--paper-light);
				border: 1px solid var(--line);
			}

			.bird-card figure {
				margin: 0;
			}

			.bird-photo {
				display: block;
				width: 100%;
				aspect-ratio: 1.25;
				object-fit: cover;
			}

			.bird-card-copy {
				padding: 1.35rem 1.4rem 1.5rem;
			}

			.bird-place {
				margin: 0 0 0.55rem;
				color: var(--accent);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
			}

			.bird-card h3 {
				margin: 0;
				font-size: 1.55rem;
				font-weight: 500;
				letter-spacing: -0.025em;
			}

			.scientific-name {
				margin: 0.2rem 0 0.8rem;
				color: var(--muted);
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 0.9rem;
				font-style: italic;
			}

			.bird-description {
				margin: 0;
				color: var(--muted);
				font-size: 0.88rem;
				line-height: 1.7;
			}

			.card-credit {
				margin: 1.1rem 0 0;
				padding-top: 0.8rem;
				border-top: 1px solid var(--line);
				color: var(--muted);
				font-size: 0.66rem;
				line-height: 1.6;
			}

			.card-credit a {
				color: var(--ink);
			}

			.coast-note {
				padding: 5rem 0;
				background: #e9eee6;
			}

			.coast-note-inner {
				display: grid;
				grid-template-columns: 0.8fr 1.2fr;
				align-items: start;
				gap: clamp(2rem, 8vw, 8rem);
			}

			.coast-note h2 {
				margin: 0;
				font-size: clamp(2.4rem, 4vw, 3.6rem);
				font-weight: 500;
				letter-spacing: -0.04em;
			}

			.habitat-list {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.5rem;
			}

			.habitat-list article {
				padding-top: 1rem;
				border-top: 1px solid #b9c6b7;
			}

			.habitat-list h3 {
				margin: 0 0 0.55rem;
				font-size: 1.15rem;
				font-weight: 600;
			}

			.habitat-list p {
				margin: 0;
				color: var(--muted);
				font-size: 0.84rem;
				line-height: 1.7;
			}

			.notes-callout {
				padding: 6rem 1.5rem;
				text-align: center;
			}

			.notes-callout h2 {
				margin: 0;
				font-size: clamp(2.4rem, 5vw, 4rem);
				font-weight: 500;
				letter-spacing: -0.04em;
			}

			.notes-callout > p:not(.eyebrow) {
				max-width: 34rem;
				margin: 1rem auto 1.5rem;
				color: var(--muted);
			}

			.notes-callout .eyebrow {
				justify-content: center;
			}

			@media (max-width: 850px) {
				.hero {
					min-height: 0;
					grid-template-columns: 1fr;
					gap: 2.5rem;
					padding: 4rem 0;
				}

				.hero-copy {
					max-width: 38rem;
				}

				.hero-figure {
					max-width: 46rem;
				}

				.bird-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}

				.coast-note-inner {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
			}

			@media (max-width: 600px) {
				.wrap,
				.hero {
					width: min(100% - 2rem, 1200px);
				}

				.hero {
					padding: 3rem 0;
				}

				.hero h1 {
					font-size: clamp(3rem, 15vw, 4.5rem);
				}

				.hero-figure {
					padding: 1rem 0 1.5rem 1rem;
				}

				.hero-figure::before {
					top: 1.5rem;
				}

				.hero-photo {
					height: 75vw;
					min-height: 260px;
				}

				.hero-caption {
					right: 0.5rem;
					bottom: 2rem;
					left: 1.5rem;
					flex-direction: column;
					align-items: flex-start;
				}

				.photo-credit {
					text-align: left;
				}

				.section {
					padding: 4rem 0;
				}

				.section-heading {
					align-items: flex-start;
					flex-direction: column;
					gap: 0.8rem;
					margin-bottom: 1.5rem;
				}

				.bird-grid,
				.habitat-list {
					grid-template-columns: 1fr;
				}

				.bird-grid {
					gap: 1rem;
				}

				.bird-photo {
					aspect-ratio: 1.5;
				}

				.coast-note {
					padding: 3.5rem 0;
				}

				.notes-callout {
					padding: 4rem 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home-main">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow">A field guide to Ireland’s west coast</p>
					<h1 id="hero-title">Wild wings on the Atlantic edge.</h1>
					<p>
						From island cliffs to sheltered bays, discover the birds that make Ireland’s western
						shore their home.
					</p>
					<div class="hero-actions">
						<a class="primary-link" href="#species">Explore the birds</a>
						<a class="text-link" href="/about">About this guide</a>
					</div>
				</div>
				<figure class="hero-figure">
					<Image
						class="hero-photo"
						src={puffinImage}
						alt="An Atlantic puffin on Skellig Michael, County Kerry"
						width={960}
						loading="eager"
						fetchpriority="high"
					/>
					<figcaption class="hero-caption">
						<span>Skellig Michael · County Kerry</span>
						<small class="photo-credit">
							Photo <a href="https://commons.wikimedia.org/wiki/File:Puffin_Skellig_Michael_2015.jpg"
								>Sascha Wenninger</a
							> · <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC BY-SA 2.0</a>
							· resized for display
						</small>
					</figcaption>
				</figure>
			</section>

			<section class="section" id="species" aria-labelledby="species-heading">
				<div class="wrap">
					<div class="section-heading">
						<div>
							<p class="eyebrow">Meet the coast’s residents</p>
							<h2 id="species-heading">Birds of the western shore</h2>
						</div>
						<p>
							A first glimpse of the seabirds and shorebirds you may encounter along the Kerry
							coast. Species notes and local guides will grow over time.
						</p>
					</div>

					<div class="bird-grid">
						{
							birds.map((bird) => (
								<article class="bird-card">
									<figure>
										<Image
											class="bird-photo"
											src={bird.image}
											alt={bird.alt}
											width={800}
											loading="lazy"
										/>
									</figure>
									<div class="bird-card-copy">
										<p class="bird-place">{bird.place}</p>
										<h3>{bird.name}</h3>
										<p class="scientific-name">{bird.scientificName}</p>
										<p class="bird-description">{bird.description}</p>
										<p class="card-credit">
											Photo <a href={bird.source}>{bird.photo}</a> ·{' '}
											<a href={bird.license}>{bird.licenseName}</a> · resized for display
										</p>
									</div>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="coast-note" aria-labelledby="habitats-heading">
				<div class="wrap coast-note-inner">
					<div>
						<p class="eyebrow">A changing landscape</p>
						<h2 id="habitats-heading">Every tide tells a different story.</h2>
					</div>
					<div class="habitat-list">
						<article>
							<h3>Island cliffs</h3>
							<p>Look out to the offshore islands, where seabirds gather on ledges above the sea.</p>
						</article>
						<article>
							<h3>Quiet estuaries</h3>
							<p>As the tide turns, sheltered bays and mudflats become feeding grounds.</p>
						</article>
						<article>
							<h3>Open Atlantic</h3>
							<p>Follow the wind above the water for fulmars, gannets and other ocean travellers.</p>
						</article>
					</div>
				</div>
			</section>

			<section class="notes-callout" aria-labelledby="notes-heading">
				<p class="eyebrow">Field notes</p>
				<h2 id="notes-heading">Stories from the shore, soon.</h2>
				<p>
					The field-notes section is ready for observations and longer reads. It will grow as new
					notes are written.
				</p>
				<a class="primary-link" href="/blog">Visit field notes</a>
			</section>
		</main>
		<Footer />
		<BackToTop />
	</body>
</html>
