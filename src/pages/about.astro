---
import BackToTop from '../components/BackToTop.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(100% - 3rem, 1200px);
				max-width: 1200px;
				padding: clamp(4rem, 10vw, 8rem) 0;
			}

			.about-grid {
				display: grid;
				grid-template-columns: 0.8fr 1.2fr;
				gap: clamp(2.5rem, 8vw, 8rem);
			}

			.eyebrow {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				margin: 0 0 1.5rem;
				color: var(--accent);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				text-transform: uppercase;
			}

			.eyebrow::before {
				width: 2rem;
				height: 1px;
				background: currentColor;
				content: '';
			}

			h1 {
				margin: 0;
				font-size: clamp(3rem, 6vw, 5.5rem);
				font-weight: 500;
				letter-spacing: -0.055em;
				line-height: 1;
			}

			.about-copy {
				padding-top: 2.6rem;
			}

			.lead {
				margin: 0 0 1.5rem;
				color: var(--ink);
				font-family: Georgia, 'Times New Roman', serif;
				font-size: clamp(1.4rem, 2.5vw, 2rem);
				line-height: 1.45;
			}

			.about-copy p:not(.lead) {
				color: var(--muted);
			}

			.about-note {
				margin-top: 2.5rem;
				padding: 1.5rem;
				border-left: 2px solid var(--accent);
				background: #e9eee6;
				color: var(--ink);
			}

			@media (max-width: 720px) {
				main {
					width: calc(100% - 2rem);
				}

				.about-grid {
					grid-template-columns: 1fr;
					gap: 1rem;
				}

				.about-copy {
					padding-top: 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="about-grid">
				<div>
					<p class="eyebrow">About this project</p>
					<h1>A closer look at the coast.</h1>
				</div>
				<div class="about-copy">
					<p class="lead">
						Atlantic Fieldnotes is a growing guide to the birds and birding places of Ireland’s
						western shore.
					</p>
					<p>
						From sea cliffs and offshore islands to sheltered bays, the Atlantic coast brings
						together a remarkable variety of habitats. This site is being shaped as a place to
						explore the birds found among them.
					</p>
					<p>
						The guide is at an early stage. Species pages and field notes will be added over time;
						for now, the photographs offer a first look at a few of the coast’s birdlife.
					</p>
					<div class="about-note">
						Photographs are credited to their photographers, with links to the source files and
						licenses.
					</div>
				</div>
			</div>
		</main>
		<Footer />
		<BackToTop />
	</body>
</html>
