---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main navigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<svg viewBox="0 0 48 48" aria-hidden="true">
				<path d="M7 30c8-1 13-8 17-17 5 9 10 16 17 17-4 8-10 12-17 12S11 38 7 30Z" />
				<path d="M16 30c5 1 10 1 16 0M19 35c3 1 7 1 10 0" />
			</svg>
			<span>
				<strong>{SITE_TITLE}</strong>
				<small>Ireland’s western shore</small>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/#species">Birds</HeaderLink>
			<HeaderLink href="/blog">Field notes</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: relative;
		z-index: 2;
		background: var(--paper);
		border-bottom: 1px solid var(--line);
	}

	nav {
		display: flex;
		width: min(100% - 3rem, 1200px);
		min-height: 5.5rem;
		align-items: center;
		justify-content: space-between;
		margin: auto;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--ink);
		text-decoration: none;
	}

	.brand svg {
		width: 2.8rem;
		height: 2.8rem;
		fill: none;
		stroke: var(--accent);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.brand span {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}

	.brand strong {
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.1rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.brand small {
		margin-top: 0.25rem;
		color: var(--muted);
		font-size: 0.7rem;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 3vw, 2.5rem);
	}

	.internal-links :global(a) {
		padding: 0.6rem 0;
		color: var(--ink);
		font-size: 0.88rem;
		text-decoration: none;
	}

	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		nav {
			width: min(100% - 2rem, 1200px);
			min-height: 4.5rem;
		}

		.brand svg {
			width: 2.2rem;
			height: 2.2rem;
		}

		.brand strong {
			font-size: 0.95rem;
		}

		.brand small {
			font-size: 0.58rem;
		}

		.internal-links {
			gap: 0.8rem;
		}

		.internal-links :global(a) {
			font-size: 0.75rem;
		}
	}
</style>
